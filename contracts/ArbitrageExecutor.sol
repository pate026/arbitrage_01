pragma solidity ^0.8.20;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";

// --- minimal interfaces ---
// we use minimal interfaces to avoid importing massive external dependencies.

interface IPool {
    function flashLoanSimple(
        address receiverAddress,
        address asset,
        uint256 amount,
        bytes calldata params,
        uint16 referralCode
    ) external;
}

interface IFlashLoanSimpleReceiver {
    function executeOperation(address asset, uint256 amount, uint256 premium, address initiator, bytes calldata params)
        external
        returns (bool);
    function ADDRESSES_PROVIDER() external view returns (address);
    function POOL() external view returns (IPool);
}

interface IUniswapV2Router {
    function swapExactTokensForTokens(
        uint256 amountIn,
        uint256 amountOutMin,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external returns (uint256[] memory amounts);
}

interface IV3Router {
    struct ExactInputSingleParams {
        address tokenIn;
        address tokenOut;
        uint24 fee;
        address recipient;
        uint256 deadline;
        uint256 amountIn;
        uint256 amountOutMinimum;
        uint160 sqrtPriceLimitX96;
    }
    function exactInputSingle(ExactInputSingleParams calldata params) external payable returns (uint256 amountOut);
}

// --- main contract ---

contract ArbitrageExecutor is IFlashLoanSimpleReceiver {
    IPool public immutable pool;
    address public owner;

    // struct matching the python payload generated by simulator
    struct SwapStep {
        address router;
        uint8 dexType; // 2 = v2, 3 = v3, 4 = aero/v3 compatible
        address tokenIn;
        address tokenOut;
        uint24 fee;
    }

    // full payload delivered by the backend script
    struct FlashloanPayload {
        address borrowAsset;
        uint256 borrowAmount;
        SwapStep step1;
        SwapStep step2;
    }

    modifier onlyOwner() {
        require(msg.sender == owner, "not owner");
        _;
    }

    constructor(address _pool) {
        pool = IPool(_pool);
        owner = msg.sender;
    }

    // required by aave iflashloansimplereceiver interface
    function ADDRESSES_PROVIDER() external pure override returns (address) {
        return address(0); // not strictly needed for our custom implementation
    }

    function POOL() external view override returns (IPool) {
        return pool;
    }

    /**
     * @dev initiates the flashloan and subsequent arbitrage routing.
     * only the owner can trigger this.
     */
    function executeArbitrage(FlashloanPayload calldata payload) external onlyOwner {
        // encode payload to pass it through the aave flashloan
        bytes memory params = abi.encode(payload);

        // request flashloan from aave v3
        pool.flashLoanSimple(address(this), payload.borrowAsset, payload.borrowAmount, params, 0);
    }

    /**
     * @dev callback function called by aave after transferring the borrowed asset to this contract.
     */
    function executeOperation(address asset, uint256 amount, uint256 premium, address initiator, bytes calldata params)
        external
        override
        returns (bool)
    {
        require(msg.sender == address(pool), "caller must be aave pool");
        require(initiator == address(this), "initiator must be this contract");

        // decode the original payload
        FlashloanPayload memory payload = abi.decode(params, (FlashloanPayload));

        // step 1: swap borrowed asset for the intermediate asset
        uint256 step1Out = _executeSwap(payload.step1, amount);

        // step 2: swap the intermediate asset back to the borrowed asset
        uint256 finalBalance = _executeSwap(payload.step2, step1Out);

        // calculate total amount owed to aave (principal + flashloan fee)
        uint256 amountOwed = amount + premium;
        require(finalBalance >= amountOwed, "arbitrage not profitable");

        // approve aave to pull the principal + fee from this contract
        IERC20(asset).approve(address(pool), amountOwed);

        // transfer the remaining profit to the owner's wallet
        uint256 profit = finalBalance - amountOwed;
        if (profit > 0) {
            IERC20(asset).transfer(owner, profit);
        }

        return true; // aave checks this return value to finalize the loan
    }

    /**
     * @dev internal function to route the swap based on the dex type.
     */
    function _executeSwap(SwapStep memory step, uint256 amountIn) internal returns (uint256) {
        // approve the router to spend our tokens
        IERC20(step.tokenIn).approve(step.router, amountIn);

        if (step.dexType == 2) {
            // uniswap v2 (and forks like sushiswap v2, pancakeswap v2)
            address[] memory path = new address[](2);
            path[0] = step.tokenIn;
            path[1] = step.tokenOut;

            uint256[] memory amounts = IUniswapV2Router(step.router)
                .swapExactTokensForTokens(
                    amountIn,
                    0, // accept any amount for now (minimums should be calculated in production)
                    path,
                    address(this),
                    block.timestamp
                );
            return amounts[1];
        } else if (step.dexType == 3 || step.dexType == 4) {
            // uniswap v3 (and forks like pancakeswap v3, aerodrome cl)
            IV3Router.ExactInputSingleParams memory v3Params = IV3Router.ExactInputSingleParams({
                tokenIn: step.tokenIn,
                tokenOut: step.tokenOut,
                fee: step.fee,
                recipient: address(this),
                deadline: block.timestamp,
                amountIn: amountIn,
                amountOutMinimum: 0,
                sqrtPriceLimitX96: 0
            });

            return IV3Router(step.router).exactInputSingle(v3Params);
        }

        revert("unsupported dex type");
    }

    /**
     * @dev rescue tokens in case they get stuck in the contract.
     */
    function rescueTokens(address token) external onlyOwner {
        uint256 balance = IERC20(token).balanceOf(address(this));
        IERC20(token).transfer(owner, balance);
    }
}
